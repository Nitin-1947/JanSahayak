# ==========================================
# JanSahayak
# ==========================================

APP_NAME=Hindi Government AI Assistant

# ==========================================
# Ollama
# ==========================================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ==========================================
# Language
# ==========================================

LANGUAGE=hi
DEFAULT_STATE=Madhya Pradesh

# ==========================================
# Database
# ==========================================

DATABASE_PATH=data/app.db

# ==========================================
# Audio
# ==========================================

AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# ==========================================
# Logging
# ==========================================

LOG_LEVEL=INFO

# ==========================================
# Telephony - Exotel
# ==========================================

TELEPHONY_ENABLED=true
TELEPHONY_PROVIDER=exotel

# Add your Exotel credentials in the actual .env file
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# Your Exotel virtual phone number / ExoPhone
EXOTEL_CALLER_ID=

# India / Mumbai Exotel cluster
EXOTEL_API_BASE_URL=

# ==========================================
# JanSahayak Voice WebSocket
# ==========================================

# Public WebSocket URL used by Exotel Voicebot
# Example:
# VOICE_WS_URL=
VOICE_WS_URL=

VOICE_SAMPLE_RATE=16000
