APP_NAME=JanSahayak

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

LANGUAGE=hi
DEFAULT_STATE=Madhya Pradesh
DATABASE_PATH=data/app.db

# Exotel sends 8 kHz mono 16-bit PCM by default.
VOICE_SAMPLE_RATE=8000
VOICE_CHANNELS=1
VOICE_CHUNK_MS=100

STT_MODEL_DIR=models/stt/vosk-model-small-hi-0.22
STT_SAMPLE_RATE=16000
VAD_RMS_THRESHOLD=450
VAD_SILENCE_MS=800
VAD_MIN_SPEECH_MS=350

TTS_MODEL_DIR=models/tts
TTS_VOICE=hi_IN-pratham-medium
TTS_USE_CUDA=false

LOG_LEVEL=INFO
